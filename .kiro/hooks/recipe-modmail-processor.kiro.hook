{
  "enabled": true,
  "name": "Recipe ModMail Processor",
  "description": "Process recipe submissions from ModMail hourly with server health checks and logging",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      ".kiro/hooks/process-recipes.sh",
      "apps/karma-lemonade-stand/package.json"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Execute the Recipe ModMail Processor hook: 1) Check server health at localhost:8080/api/health 2) Run the process-recipes.sh script from the karma-lemonade-stand directory 3) Log completion with timestamp 4) Implement retry logic with 1 retry attempt and 5-minute delay on failure 5) Alert on failure"
  }
}